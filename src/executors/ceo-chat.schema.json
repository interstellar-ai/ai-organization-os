{
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "suggestedAction"],
  "properties": {
    "reply": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "suggestedAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "description"],
          "properties": {
            "type": { "const": "propose_goal" },
            "title": { "type": "string", "minLength": 1, "maxLength": 180 },
            "description": { "type": "string", "minLength": 1, "maxLength": 12000 }
          }
        }
      ]
    }
  }
}
